FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

solver          incompressibleFluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         20000;
deltaT          1;
writeControl    timeStep;
writeInterval   20000;
writeFormat     ascii;
writePrecision  12;
timeFormat      general;
runTimeModifiable false;
functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        patches         (body);
        rho             rhoInf;
        rhoInf          1000.0;
        CofR            (0.2 0.2 0);
        log             false;
    }
}
