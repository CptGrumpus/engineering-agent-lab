FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0.9999999999999999 0 0);
boundaryField
{
    wall   { type noSlip; }
    inlet  { type cyclic; }
    outlet { type cyclic; }
    front  { type wedge; }
    back   { type wedge; }
    axis   { type empty; }
}
