FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    wall   { type zeroGradient; }
    inlet  { type cyclic; }
    outlet { type cyclic; }
    front  { type wedge; }
    back   { type wedge; }
    axis   { type empty; }
}
