FoamFile
{
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p_rgh { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.01; maxIter 200; }
    "(U|h)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0.05; }
}
PIMPLE
{
    momentumPredictor yes;
    pRefCell 0;
    pRefValue 1e5;
    residualControl { p_rgh 9.999999999999999e-06; U 1e-07; h 1e-07; }
}
relaxationFactors
{
    fields { p_rgh 0.7; }
    equations { U 0.3; h 0.5; }
}
