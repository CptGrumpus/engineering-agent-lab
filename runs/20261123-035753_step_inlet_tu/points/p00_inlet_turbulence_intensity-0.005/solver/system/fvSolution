FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-10; relTol 0.05; }
    "(U|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-12; relTol 0.05; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      no;
    residualControl { p 1e-06; U 2e-07; "(k|omega)" 2e-06; }
}
relaxationFactors
{
    fields { p 0.3; }
    equations { U 0.7; "(k|omega)" 0.5; }
}
