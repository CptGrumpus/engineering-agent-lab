FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

solver          functions;
subSolver       incompressibleFluid;
startFrom       latestTime;
stopAt          endTime;
endTime         28500;
writeInterval   100;
purgeWrite      2;
deltaT          1;
writeControl    timeStep;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;

functions
{
    T
    {
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");
        field           T;
        diffusivity     viscosity;
        alphal          0.1631632707918929;
        alphat          1;
        writeControl    writeTime;
    }
}
