FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0.03333333333333333 0 0);
boundaryField
{
    inlet { type flowRateInletVelocity; volumetricFlowRate 1.05e-07; profile laminarBL; value uniform (0 0 0); }
    outlet       { type zeroGradient; }
    walls        { type noSlip; }
    frontAndBack { type empty; }
}
